// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Lightweight contact submission log (no protected health or notarization PII stored)
model ContactSubmission {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  name             String
  email            String
  phone            String
  serviceRequested String
  message          String
  isProcessed      Boolean  @default(false)
}

// General audit logs for system activity (e.g. webhook triggers or scheduling clicks)
model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  action    String
  details   String?
}
